{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.rana.beer"
        }
      ],
      "destination": "https://rana.beer/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/homeuni/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/14-0",
      "destination": "https://fourteen-zero.vercel.app/14-0"
    },
    {
      "source": "/14-0/:path*",
      "destination": "https://fourteen-zero.vercel.app/14-0/:path*"
    },
    {
      "source": "/onecal",
      "destination": "https://onecal-app.vercel.app/"
    },
    {
      "source": "/onecal/",
      "destination": "https://onecal-app.vercel.app/"
    },
    {
      "source": "/onecal/:path*",
      "destination": "https://onecal-app.vercel.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/homeuni/stats.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/hu/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
